From 875844590b5561bf0518f19b047431728d8e44c2 Mon Sep 17 00:00:00 2001
From: FlameFlag <github@flameflag.dev>
Date: Sat, 11 Apr 2026 18:20:49 +0300
Subject: [PATCH 4/5] GUI_App: guard wxFileSystemWatcher usage with
 wxUSE_FSWATCHER

wxWidgets may be built without filesystem watcher support
(wxUSE_FSWATCHER=0). Guard all wxFileSystemWatcher usage with
preprocessor checks to allow building in this configuration.
---
 src/slic3r/GUI/GUI_App.cpp | 4 ++++
 src/slic3r/GUI/GUI_App.hpp | 6 ++++++
 2 files changed, 10 insertions(+)

diff --git a/src/slic3r/GUI/GUI_App.cpp b/src/slic3r/GUI/GUI_App.cpp
index 789dac58..511362a0 100644
--- a/src/slic3r/GUI/GUI_App.cpp
+++ b/src/slic3r/GUI/GUI_App.cpp
@@ -1480,6 +1480,7 @@ void GUI_App::post_login_status_cmd(bool isSuccess, UserInfo user)
 }
 
 // param_set 参数集合页
+#if wxUSE_FSWATCHER
 
 // 启动监听 user_info.json 的文件变更，用于跨进程同步登录状态到当前实例
 void GUI_App::start_user_info_watcher()
@@ -1569,6 +1570,7 @@ void GUI_App::on_user_info_file_event(wxFileSystemWatcherEvent& evt)
         apply_logout();
     }
 }
+#endif // wxUSE_FSWATCHER
 // token_expired token过期
 // login 登录
 void GUI_App::swith_community_sub_page(const std::string& pageName)
@@ -4452,8 +4454,10 @@ bool GUI_App::on_init_inner(bool isdump_launcher)
     mainframe->Show(true);
     BOOST_LOG_TRIVIAL(info) << "main frame firstly shown";
 
+#if wxUSE_FSWATCHER
     // 启动用户信息文件监听，确保跨实例同步在线模型库登录状态
     start_user_info_watcher();
+#endif
 
 //#if BBL_HAS_FIRST_PAGE
     //BBS: set tp3DEditor firstly
diff --git a/src/slic3r/GUI/GUI_App.hpp b/src/slic3r/GUI/GUI_App.hpp
index c2b6bfa6..b1d8a69b 100644
--- a/src/slic3r/GUI/GUI_App.hpp
+++ b/src/slic3r/GUI/GUI_App.hpp
@@ -7,7 +7,9 @@
 #include <wx/string.h>
 #include <wx/snglinst.h>
 #include <wx/msgdlg.h>
+#if wxUSE_FSWATCHER
 #include <wx/fswatcher.h>
+#endif
 #include <wx/filename.h>
 
 #include <memory>
@@ -783,9 +785,11 @@ private:
     std::string preset_type_local_device() { return "local_device"; }
     std::string get_local_device_dir();
 
+#if wxUSE_FSWATCHER
     // 跨实例登录同步：监听 user_info.json 变更
     void            start_user_info_watcher();
     void            on_user_info_file_event(wxFileSystemWatcherEvent& evt);
+#endif
 
     long long get_app_startup_duration();
     long get_app_running_duration();
@@ -860,8 +864,10 @@ private:
     EPickingEffect          m_picking_effect{ EPickingEffect::Silhouette };
     ColorRGB                m_picking_color{ 1.0f, 1.0f, 1.0f };
 
+#if wxUSE_FSWATCHER
     // 文件系统监听器：监控 user_info.json 改变以同步登录状态
     std::unique_ptr<wxFileSystemWatcher> m_user_info_watcher;
+#endif
 
 };
 
